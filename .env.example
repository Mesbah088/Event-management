# ==============================================================
# UNIVERSITY EVENT QR CODE ENTRY MANAGEMENT SYSTEM
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================

# MongoDB Connection
# Set your MongoDB connection URI (Atlas or local replica set)
MONGODB_URI=mongodb://localhost:27017/university_events
MONGODB_DB_NAME=university_events

# Resend API Key for Transactional Emails
# Format: re_xxxxxxxxxxxx
RESEND_API_KEY=re_123456789_placeholder
EMAIL_FROM=University Events <events@yourcampus.edu>

# Application Base URL (No trailing slash)
APP_URL=http://localhost:3000

# Session Secret (minimum 32 characters for HMAC SHA-256)
SESSION_SECRET=super_secret_jwt_session_signing_key_at_least_32_chars_long

# Initial Administrator Bootstrap Configuration
# Used for one-time initialization of the single Admin account
INITIAL_ADMIN_EMAIL=admin@university.edu
INITIAL_ADMIN_PASSWORD=AdminSecurePassword2026!
INITIAL_ADMIN_NAME=Super Administrator

# Security & Setup Locking (set to true in production after initial admin bootstrap)
ADMIN_BOOTSTRAP_LOCKED=false

# Node Environment
NODE_ENV=development
